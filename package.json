  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@superapp/embed-sdk": "github:jiguangliandong/superapp-embed-js-sdk#8b04b8ebf18652efc0e08af3a198121fdaa87109",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
