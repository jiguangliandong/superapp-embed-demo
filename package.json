{
  "name": "superapp-h5-sso-demo",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "prestart": "npm run build:client",
    "start": "node src/server.js",
    "predev": "npm run build:client",
    "dev": "node --watch src/server.js",
    "build:client": "esbuild src/client/app.js --bundle --platform=browser --format=iife --target=es2022 --outfile=public/js/app.bundle.js",
    "watch:client": "esbuild src/client/app.js --bundle --platform=browser --format=iife --target=es2022 --outfile=public/js/app.bundle.js --watch",
    "test": "node --test"
  },
  "keywords": [],
