PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
SUPERAPP_BASE_URL=http://localhost:8080
SUPERAPP_CLIENT_ID=embcli_replace_me
SUPERAPP_KEY_ID=replace-me
SUPERAPP_PRIVATE_KEY_PATH=/absolute/path/to/partner-private-key.pem
PARTNER_ALLOWED_SCOPES=auth_base,profile.name,contact.phone,contact.email,kyc.status
SSO_TRANSACTION_TTL_SECONDS=300
SUPERAPP_TOKEN_ENDPOINT=http://localhost:8080/api/embed/v1/oauth/token
SUPERAPP_USERINFO_ENDPOINT=http://localhost:8080/api/embed/v1/userinfo
SUPERAPP_REVOCATION_ENDPOINT=http://localhost:8080/api/embed/v1/oauth/revoke
