<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css">
    <script src="/js/app.bundle.js" defer></script>
  </head>

  <body data-client-id="<%= clientId %>">
    <main class="container">
      <section class="card">
        <p class="eyebrow">Partner H5</p>
        <h1><%= title %></h1>
        <p>这是运行在 SuperApp WebView 中的第三方业务页面。</p>

        <dl class="status-list">
          <div>
            <dt>Partner 服务</dt>
            <dd class="success">已启动</dd>
          </div>
          <div>
            <dt>启动上下文</dt>
            <dd><%= hasLaunchContext ? "已检测到 launch_id" : "普通访问" %></dd>
          </div>
          <div>
            <dt>宿主环境</dt>
            <dd id="context-status">检测中…</dd>
          </div>
          <div>
            <dt>SSO 状态</dt>
            <dd id="sso-status">尚未登录</dd>
          </div>
        </dl>

        <div class="actions">
          <button id="login-button" type="button" disabled>
            使用 SuperApp 登录
          </button>
          <button id="privacy-button" type="button" disabled>
            授权管理
          </button>
          <button id="close-button" type="button" disabled>
            关闭
          </button>
        </div>

        <p id="error-detail" class="error" hidden></p>

        <section id="profile" class="profile" hidden>
          <div id="profile-avatar" class="profile-avatar" aria-hidden="true"></div>
          <div>
            <p class="profile-label">已登录用户</p>
            <h2 id="profile-name"></h2>
          </div>
          <pre id="profile-details" class="result"></pre>
        </section>

        <a href="/privacy">查看 Partner 隐私政策</a>
      </section>
    </main>
  </body>
</html>
